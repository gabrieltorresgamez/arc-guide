---
// Starlight's footer plus a link to the privacy notice on every page.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />
<p class="legal"><a href="/privacy/">Privacy notice</a></p>

<style>
	.legal {
		margin-top: 2rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.legal a {
		display: inline-block;
		padding-block: 0.5rem; /* a 33px tap target instead of 17px */
		color: inherit;
	}
</style>
