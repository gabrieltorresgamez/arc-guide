---
// Starlight's right sidebar plus a live graph of the pages around this one, laid out by a force simulation
// (d3-force) like Obsidian's and Quartz's graph view. The sidebar shows one step (links in both directions); the
// expand button opens a large view with two steps, zoom and pan. Forces and dot sizes are Quartz's defaults.
// Data: /graph.json from pipeline/build.py. Script and data load only on screens wide enough to show the sidebar.
import Default from '@astrojs/starlight/components/PageSidebar.astro';

const isConcept = Astro.locals.starlightRoute.id.startsWith('concepts/');
const title = Astro.locals.starlightRoute.entry.data.title;
---

<Default />
{
	isConcept && (
		<div class="page-graph sl-hidden lg:sl-block">
			<div class="pg-head">
				<h2>Linked pages</h2>
				<button class="pg-icon pg-open" type="button" aria-label="Show linked pages in a large view">
					<svg viewBox="0 0 20 20" aria-hidden="true">
						<path d="M12 3h5v5M17 3l-6 6M8 17H3v-5M3 17l6-6" />
					</svg>
				</button>
			</div>
			<div class="pg-box">
				<svg class="pg-svg" role="group" aria-label="Pages linked with this one" />
			</div>
			<p class="pg-caption" aria-live="polite">Point at a dot to see its name. Drag to move it.</p>
			<dialog class="pg-window" aria-label={`Linked pages: ${title}`}>
				<div class="pg-bar">
					<span class="pg-title">linked pages: {title}</span>
					<button class="pg-icon pg-close" type="button" aria-label="Close">
						<svg viewBox="0 0 20 20" aria-hidden="true">
							<path d="M5 5l10 10M15 5L5 15" />
						</svg>
					</button>
				</div>
				<div class="pg-stage">
					<svg class="pg-svg pg-zoom" role="group" aria-label="Pages linked with this one, two steps out" />
				</div>
				<p class="pg-caption" aria-live="polite">
					Point at a dot to see its name. Scroll to zoom, drag the background to move, double-click to fit.
				</p>
			</dialog>
		</div>
	)
}

<script>
	type D3 = typeof import('d3-force');
	type Data = { nodes: [string, string][]; links: [number, number][] };
	type Node = { s: number; r: number; url: string; title: string; x?: number; y?: number; fx?: number | null; fy?: number | null; index?: number };
	type Link = { source: number | Node; target: number | Node };

	const box = document.querySelector<HTMLElement>('.page-graph');
	const wide = matchMedia('(min-width: 72rem)');
	const still = matchMedia('(prefers-reduced-motion: reduce)');
	let lib: Promise<[D3, Data]> | undefined;
	const load = () => (lib ??= Promise.all([import('d3-force'), fetch('/graph.json').then((r) => r.json())]));

	/** Draw the current page's graph into `svg`, `depth` steps out. A dot shows its name only while pointed at or
	 *  focused; `zoomable` adds wheel zoom, background pan and double-click to fit. */
	function draw([d3, data]: [D3, Data], svg: SVGSVGElement, caption: Element, depth: number, zoomable: boolean) {
		svg.replaceChildren();
		const here = data.nodes.findIndex((n) => n[0] === location.pathname);
		if (here < 0) return;
		const adj = data.nodes.map(() => new Set<number>());
		for (const [a, b] of data.links) adj[a].add(b), adj[b].add(a);
		const step = new Map([[here, 0]]);
		for (let s = 1, grew = true; s <= depth && grew; s++) {
			grew = false;
			for (const [i, t] of [...step]) if (t === s - 1) for (const j of adj[i]) if (!step.has(j)) step.set(j, s), (grew = true);
		}
		// Dot radius on screen as in Quartz: 2px plus the square root of the page's number of links, so hubs stand out.
		const nodes: Node[] = [...step].map(([i, s]) => ({ s, r: 2 + Math.sqrt(adj[i].size), url: data.nodes[i][0], title: data.nodes[i][1] }));
		const at = new Map([...step.keys()].map((i, k) => [i, k]));
		const links: Link[] = data.links.filter(([a, b]) => at.has(a) && at.has(b)).map(([a, b]) => ({ source: at.get(a)!, target: at.get(b)! }));
		nodes[0].fx = nodes[0].fy = 0; // this page stays in the middle

		const hint = caption.textContent;
		const el = (tag: string, attrs: Record<string, string>, parent: Element) => {
			const e = document.createElementNS('http://www.w3.org/2000/svg', tag);
			for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
			return parent.appendChild(e);
		};
		const lineGroup = el('g', {}, svg);
		const lines = links.map(() => el('line', { 'vector-effect': 'non-scaling-stroke' }, lineGroup));
		const dots = nodes.map((n) => {
			const a = el('a', { href: n.url, class: `pg-${Math.min(n.s, 2)}`, 'aria-label': n.title }, svg);
			if (n.s !== 1) a.setAttribute('tabindex', '-1'); // keyboard users get the direct neighbors only
			el('circle', {}, a);
			el('text', {}, a).textContent = n.title;
			return a;
		});
		const circles = dots.map((d) => d.querySelector('circle')!);

		// The view: fitted to the dots (zoom out like Obsidian) until the reader zooms or pans. Dots, lines and labels
		// keep their size on screen at any zoom.
		const setView = (x: number, y: number, w: number, h: number) => {
			svg.setAttribute('viewBox', `${x} ${y} ${w} ${h}`);
			const k = w / (svg.clientWidth || 256); // user units per screen pixel
			svg.style.setProperty('--k', `${k}`);
			circles.forEach((c, j) => c.setAttribute('r', `${nodes[j].r * k}`));
		};
		let userView = false;
		let dragging: number | null = null;
		let moved = false;
		const fit = () => {
			const xs = nodes.map((n) => n.x!), ys = nodes.map((n) => n.y!);
			const aspect = svg.clientWidth / (svg.clientHeight || svg.clientWidth) || 1;
			const w = Math.max(120, Math.max(...xs) - Math.min(...xs) + 50, (Math.max(...ys) - Math.min(...ys) + 50) * aspect);
			const cx = (Math.max(...xs) + Math.min(...xs)) / 2, cy = (Math.max(...ys) + Math.min(...ys)) / 2;
			setView(cx - w / 2, cy - w / aspect / 2, w, w / aspect);
		};
		const render = () => {
			if (dragging === null && !userView) fit();
			links.forEach((l, k) => {
				const [s, t] = [l.source as Node, l.target as Node];
				lines[k].setAttribute('x1', `${s.x}`), lines[k].setAttribute('y1', `${s.y}`);
				lines[k].setAttribute('x2', `${t.x}`), lines[k].setAttribute('y2', `${t.y}`);
			});
			dots.forEach((d, k) => d.setAttribute('transform', `translate(${nodes[k].x} ${nodes[k].y})`));
		};
		const sim = d3
			.forceSimulation(nodes as any)
			// Quartz's local graph: repelForce 0.5 (strength -50), linkDistance 30, centerForce 0.3 (keeps the group
			// centred without squeezing it), collisions solved in three passes.
			.force('charge', d3.forceManyBody().strength(-50))
			.force('link', d3.forceLink(links as any).distance(30))
			.force('center', d3.forceCenter().strength(0.3))
			.force('collide', d3.forceCollide(7).iterations(3))
			.alphaDecay(0.045)
			.on('tick', render);
		if (still.matches) sim.stop().tick(300), render();

		// Point at or focus a dot: it, its neighbors and their links stay, the rest fades.
		const near = nodes.map(() => new Set<number>());
		for (const l of links) near[(l.source as Node).index!].add((l.target as Node).index!), near[(l.target as Node).index!].add((l.source as Node).index!);
		const highlight = (k: number | null) => {
			svg.classList.toggle('pg-dim', k !== null);
			dots.forEach((d, j) => {
				d.classList.toggle('pg-on', k !== null && (j === k || near[k].has(j)));
				d.classList.toggle('pg-hover', j === k);
			});
			lines.forEach((ln, j) => {
				const l = links[j];
				ln.classList.toggle('pg-on', k !== null && ((l.source as Node).index === k || (l.target as Node).index === k));
			});
			caption.textContent = k === null ? hint : nodes[k].title;
		};
		dots.forEach((d, k) => {
			d.addEventListener('pointerenter', () => dragging === null && highlight(k));
			d.addEventListener('pointerleave', () => dragging === null && highlight(null));
			d.addEventListener('focus', () => highlight(k));
			d.addEventListener('blur', () => highlight(null));
			d.addEventListener('click', (e) => moved && e.preventDefault()); // a drag is not a click
			d.addEventListener('pointerdown', (e) => {
				e.stopPropagation(); // a dot is dragged, the background pans
				if (k === 0) return;
				dragging = k;
				moved = false;
				d.setPointerCapture(e.pointerId);
				sim.alphaTarget(0.3).restart();
			});
		});

		const toSvg = (e: MouseEvent) => new DOMPoint(e.clientX, e.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
		let pan: { x: number; y: number; v: DOMRect } | null = null;
		svg.onpointerdown = (e) => {
			if (!zoomable) return;
			pan = { x: e.clientX, y: e.clientY, v: DOMRect.fromRect(svg.viewBox.baseVal) };
			svg.setPointerCapture(e.pointerId);
		};
		svg.onpointermove = (e) => {
			if (dragging !== null) {
				const p = toSvg(e);
				(nodes[dragging].fx = p.x), (nodes[dragging].fy = p.y);
				moved = true;
			} else if (pan) {
				const k = pan.v.width / svg.clientWidth;
				userView = true;
				setView(pan.v.x - (e.clientX - pan.x) * k, pan.v.y - (e.clientY - pan.y) * k, pan.v.width, pan.v.height);
			}
		};
		svg.onpointerup = () => {
			pan = null;
			if (dragging === null) return;
			nodes[dragging].fx = nodes[dragging].fy = null;
			dragging = null;
			sim.alphaTarget(0);
		};
		const zoom = (factor: number, p?: DOMPoint) => {
			const v = svg.viewBox.baseVal;
			const w = Math.min(8000, Math.max(60, v.width * factor));
			const c = p ?? new DOMPoint(v.x + v.width / 2, v.y + v.height / 2);
			const r = w / v.width;
			userView = true;
			setView(c.x - (c.x - v.x) * r, c.y - (c.y - v.y) * r, w, v.height * r);
		};
		svg.onwheel = (e) => {
			if (!zoomable) return;
			e.preventDefault();
			zoom(Math.exp(e.deltaY * 0.0015), toSvg(e));
		};
		svg.ondblclick = (e) => {
			if (!zoomable || (e.target as Element).closest('a')) return;
			userView = false;
			fit();
		};
		return {
			stop: () => sim.stop(),
			zoom,
			fit: () => ((userView = false), fit()),
		};
	}

	if (box) {
		const [small, large] = box.querySelectorAll<SVGSVGElement>('.pg-svg');
		const [smallCaption, largeCaption] = box.querySelectorAll('.pg-caption');
		const win = box.querySelector('dialog')!;
		let view: ReturnType<typeof draw>;
		let started = false;
		const start = () => {
			if (!wide.matches || started) return;
			started = true;
			load().then((l) => draw(l, small, smallCaption, 1, false));
		};
		start();
		wide.addEventListener('change', start);

		const showLarge = async () => {
			view?.stop();
			view = draw(await load(), large, largeCaption, 2, true);
		};
		const instant = (e: Event) => win.classList.toggle('instant', (e as MouseEvent).detail === 0); // keyboard: no motion
		box.querySelector('.pg-open')!.addEventListener('click', (e) => {
			instant(e);
			win.showModal();
			showLarge();
		});
		win.querySelector('.pg-close')!.addEventListener('click', (e) => {
			instant(e);
			win.close();
		});
		win.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') win.classList.add('instant');
			if (e.key === '+' || e.key === '=') view?.zoom(0.8);
			if (e.key === '-') view?.zoom(1.25);
			if (e.key === '0') view?.fit();
		});
		win.addEventListener('click', (e) => e.target === win && win.close()); // a click on the veil closes
		win.addEventListener('close', () => view?.stop());
	}
</script>

<style>
	/* Torres charts: accent for the one thing that matters (this page), ink for the series, border for the rest.
	   The small box is a level 1 panel: canvas-soft, no border (a hairline outline in the high-contrast themes). */
	.page-graph {
		padding: 1rem var(--sl-sidebar-pad-x);
	}
	.pg-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 16rem;
		margin-bottom: 0.5rem;
	}
	.pg-head h2 {
		color: var(--ink);
		font-size: var(--sl-text-h5);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
	}
	.pg-icon {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		cursor: pointer;
		transition: scale 140ms var(--ease-out);
	}
	.pg-icon svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.pg-icon:active {
		scale: 0.95;
	}
	.pg-icon:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	@media (hover: hover) and (pointer: fine) {
		.pg-icon:hover {
			background: var(--canvas-soft);
		}
	}
	.pg-box {
		max-width: 16rem;
		background: var(--canvas-soft);
		border-radius: var(--radius);
		overflow: hidden;
	}
	:global(:root[data-contrast]) .pg-box {
		outline: 1px solid var(--hairline);
	}
	.pg-box .pg-svg {
		aspect-ratio: 1;
	}
	.pg-svg {
		display: block;
		width: 100%;
		height: auto;
		touch-action: none;
	}
	.pg-zoom {
		cursor: grab;
	}
	.pg-zoom:active {
		cursor: grabbing;
	}
	.pg-svg :global(line) {
		stroke: var(--hairline);
		stroke-width: 1;
		transition: opacity 160ms ease;
	}
	.pg-svg :global(a) {
		cursor: pointer;
		transition: opacity 160ms ease;
	}
	.pg-svg :global(circle) {
		fill: var(--border);
		stroke: transparent;
		stroke-width: calc(8px * var(--k, 1)); /* a bigger target than the dot */
	}
	.pg-svg :global(.pg-1 circle) {
		fill: var(--ink);
	}
	.pg-svg :global(.pg-0 circle) {
		fill: var(--accent);
	}
	.pg-svg :global(text) {
		fill: var(--ink);
		font-size: calc(13px * var(--k, 1)); /* 13px on screen at any zoom */
		font-weight: 500;
		text-anchor: middle;
		paint-order: stroke;
		stroke: var(--canvas-soft);
		stroke-width: calc(3px * var(--k, 1));
		translate: 0 calc(-10px * var(--k, 1));
		pointer-events: none;
		opacity: 0;
		transition: opacity 160ms ease;
	}
	.pg-svg :global(.pg-hover text) {
		opacity: 1;
	}
	.pg-svg:global(.pg-dim) :global(a:not(.pg-on)) {
		opacity: 0.2;
	}
	.pg-svg:global(.pg-dim) :global(line:not(.pg-on)) {
		opacity: 0.1;
	}
	.pg-svg:global(.pg-dim) :global(line.pg-on) {
		stroke: var(--border);
	}
	.pg-svg :global(a:focus-visible) {
		outline: none;
	}
	.pg-svg :global(a:focus-visible circle) {
		stroke: var(--accent);
		stroke-width: calc(2px * var(--k, 1));
	}
	.pg-caption {
		margin-top: 0.75rem;
		max-width: 16rem;
		min-height: 2.6em;
		color: var(--ink-muted);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
	}

	/* The large view: a Torres Window in front (elevation 3: surface-raised, 1px border, elevation-3), modal over a
	   veil. Opens with a fade and a scale from 0.96 in 180ms, closes to 0.97 in 120ms; from the keyboard, at once. */
	.pg-window {
		position: fixed;
		inset: 0;
		margin: auto; /* centred, 2rem from every edge (Starlight's reset removes the dialog's own auto margins) */
		width: calc(100vw - 4rem);
		height: calc(100dvh - 4rem);
		max-width: none;
		max-height: none;
		padding: 0;
		color: var(--ink);
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--elevation-3);
		opacity: 0;
		scale: 0.97;
		transition: opacity 120ms var(--ease-out), scale 120ms var(--ease-out), display 120ms allow-discrete, overlay 120ms allow-discrete;
	}
	.pg-window[open] {
		display: flex;
		flex-direction: column;
		opacity: 1;
		scale: 1;
		transition-duration: 180ms;
	}
	@starting-style {
		.pg-window[open] {
			opacity: 0;
			scale: 0.96;
		}
	}
	.pg-window::backdrop {
		background: color-mix(in srgb, var(--canvas) 75%, transparent);
		opacity: 0;
		transition: opacity 120ms var(--ease-out), display 120ms allow-discrete, overlay 120ms allow-discrete;
	}
	.pg-window[open]::backdrop {
		opacity: 1;
		transition-duration: 180ms;
	}
	@starting-style {
		.pg-window[open]::backdrop {
			opacity: 0;
		}
	}
	.pg-window.instant,
	.pg-window.instant::backdrop {
		transition: none;
	}
	.pg-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.25rem;
		padding: 0.375rem 0.5rem 0.375rem 1.5rem;
		border-bottom: 1px solid var(--hairline);
	}
	.pg-title {
		color: var(--ink);
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
	}
	.pg-window .pg-svg :global(text) {
		stroke: var(--surface-raised);
	}
	.pg-stage {
		position: relative;
		flex: 1;
		min-height: 0;
	}
	.pg-stage .pg-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.pg-window .pg-caption {
		max-width: none;
		min-height: 0;
		margin: 0;
		padding: 0.75rem 1.5rem 1rem;
		border-top: 1px solid var(--hairline);
	}
	:global(html:has(.pg-window[open])) {
		overflow: hidden;
	}
	@media (prefers-reduced-motion: reduce) {
		.pg-svg :global(line),
		.pg-svg :global(a),
		.pg-svg :global(text) {
			transition: none;
		}
		.pg-window,
		.pg-window[open] {
			scale: 1;
		}
		@starting-style {
			.pg-window[open] {
				scale: 1;
			}
		}
	}
</style>
