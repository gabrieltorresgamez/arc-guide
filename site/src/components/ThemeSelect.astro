---
// Starlight's theme select with a fourth choice: Auto, Light, Dark, High contrast. The logic is in ThemeProvider.astro.
import Select from '@astrojs/starlight/components/Select.astro';
---

<starlight-theme-select>
	<Select
		icon="laptop"
		label={Astro.locals.t('themeSelect.accessibleLabel')}
		options={[
			{ label: Astro.locals.t('themeSelect.dark'), selected: false, value: 'dark' },
			{ label: Astro.locals.t('themeSelect.light'), selected: false, value: 'light' },
			{ label: Astro.locals.t('themeSelect.auto'), selected: true, value: 'auto' },
			{ label: 'High contrast', selected: false, value: 'hc' },
		]}
		width="10em"
	/>
</starlight-theme-select>

{/* Inlined to avoid a flash of the wrong choice. */}
<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	const provider = (window as any).StarlightThemeProvider;

	// Follow the system while the choice is Auto or High contrast.
	for (const query of ['(prefers-color-scheme: light)', '(prefers-contrast: more)']) {
		matchMedia(query).addEventListener('change', () => provider.apply());
	}

	customElements.define(
		'starlight-theme-select',
		class extends HTMLElement {
			constructor() {
				super();
				this.querySelector('select')?.addEventListener('change', (e) => {
					const theme = (e.currentTarget as HTMLSelectElement).value;
					if (typeof localStorage !== 'undefined') {
						localStorage.setItem('starlight-theme', theme === 'auto' ? '' : theme);
					}
					provider.apply(theme);
					provider.updatePickers(theme);
				});
			}
		}
	);
</script>
