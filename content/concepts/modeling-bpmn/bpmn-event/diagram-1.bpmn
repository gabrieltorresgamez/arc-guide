<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.org/events">
  <process id="p1" isExecutable="false">
    <startEvent id="s" name="Order received">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="t1" name="Check stock">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <intermediateThrowEvent id="lt" name="Skip to shipping">
      <incoming>f2</incoming>
      <linkEventDefinition id="ld1" name="ship" />
    </intermediateThrowEvent>
    <intermediateCatchEvent id="lc" name="Shipping">
      <outgoing>f3</outgoing>
      <linkEventDefinition id="ld2" name="ship" />
    </intermediateCatchEvent>
    <task id="t2" name="Ship order">
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
    </task>
    <endEvent id="e" name="Order shipped">
      <incoming>f4</incoming>
      <terminateEventDefinition id="td" />
    </endEvent>
    <sequenceFlow id="f1" sourceRef="s" targetRef="t1" />
    <sequenceFlow id="f2" sourceRef="t1" targetRef="lt" />
    <sequenceFlow id="f3" sourceRef="lc" targetRef="t2" />
    <sequenceFlow id="f4" sourceRef="t2" targetRef="e" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p1">
    <bpmndi:BPMNPlane id="BPMNPlane_p1" bpmnElement="p1">
      <bpmndi:BPMNShape id="BPMNShape_s" bpmnElement="s">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="68" y="143" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_t1" bpmnElement="t1">
        <dc:Bounds x="216" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lt" bpmnElement="lt">
        <dc:Bounds x="416" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="404" y="143" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lc" bpmnElement="lc">
        <dc:Bounds x="80" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="67" y="383" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_t2" bpmnElement="t2">
        <dc:Bounds x="216" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_e" bpmnElement="e">
        <dc:Bounds x="416" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="408" y="383" width="53" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f1" bpmnElement="f1">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="216" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f2" bpmnElement="f2">
        <di:waypoint x="316" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f3" bpmnElement="f3">
        <di:waypoint x="116" y="360" />
        <di:waypoint x="216" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f4" bpmnElement="f4">
        <di:waypoint x="316" y="360" />
        <di:waypoint x="416" y="360" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
