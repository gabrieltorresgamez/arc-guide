<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.org/bpmn">
  <process id="complaint" isExecutable="false">
    <startEvent id="start" name="Complaint received">
      <outgoing>f1</outgoing>
    </startEvent>
    <exclusiveGateway id="xor" name="Refund or replace?">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
      <outgoing>f3</outgoing>
    </exclusiveGateway>
    <task id="refund" name="Refund">
      <incoming>f2</incoming>
      <outgoing>f4</outgoing>
    </task>
    <task id="replace" name="Replace item">
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
    </task>
    <exclusiveGateway id="xorJoin">
      <incoming>f4</incoming>
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
    </exclusiveGateway>
    <parallelGateway id="andSplit">
      <incoming>f6</incoming>
      <outgoing>f7</outgoing>
      <outgoing>f8</outgoing>
    </parallelGateway>
    <task id="notify" name="Notify customer">
      <incoming>f7</incoming>
      <outgoing>f9</outgoing>
    </task>
    <task id="log" name="Update records">
      <incoming>f8</incoming>
      <outgoing>f10</outgoing>
    </task>
    <parallelGateway id="andJoin">
      <incoming>f9</incoming>
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
    </parallelGateway>
    <endEvent id="end" name="Complaint closed">
      <incoming>f11</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="start" targetRef="xor" />
    <sequenceFlow id="f2" sourceRef="xor" targetRef="refund" />
    <sequenceFlow id="f3" sourceRef="xor" targetRef="replace" />
    <sequenceFlow id="f4" sourceRef="refund" targetRef="xorJoin" />
    <sequenceFlow id="f5" sourceRef="replace" targetRef="xorJoin" />
    <sequenceFlow id="f6" sourceRef="xorJoin" targetRef="andSplit" />
    <sequenceFlow id="f7" sourceRef="andSplit" targetRef="notify" />
    <sequenceFlow id="f8" sourceRef="andSplit" targetRef="log" />
    <sequenceFlow id="f9" sourceRef="notify" targetRef="andJoin" />
    <sequenceFlow id="f10" sourceRef="log" targetRef="andJoin" />
    <sequenceFlow id="f11" sourceRef="andJoin" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_complaint">
