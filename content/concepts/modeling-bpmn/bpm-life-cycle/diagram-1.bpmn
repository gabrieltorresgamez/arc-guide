  <process id="lifecycle" isExecutable="false">
    <startEvent id="s" name="Process needs documenting or improving">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="t1" name="Discovery: build as-is model">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <task id="t2" name="Analysis: find weak points and causes">
      <incoming>f2</incoming>
      <incoming>f7</incoming>
      <outgoing>f3</outgoing>
    </task>
    <task id="t3" name="Design: define to-be model">
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
    </task>
    <task id="t4" name="Implementation: go live">
      <incoming>f4</incoming>
      <outgoing>f5</outgoing>
    </task>
    <task id="t5" name="Monitoring: track KPIs">
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
    </task>
    <exclusiveGateway id="g" name="Deviation found?">
      <incoming>f6</incoming>
      <outgoing>f7</outgoing>
      <outgoing>f8</outgoing>
    </exclusiveGateway>
    <endEvent id="e" name="Process stays as is">
      <incoming>f8</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="s" targetRef="t1" />
    <sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <sequenceFlow id="f3" sourceRef="t2" targetRef="t3" />
    <sequenceFlow id="f4" sourceRef="t3" targetRef="t4" />
    <sequenceFlow id="f5" sourceRef="t4" targetRef="t5" />
    <sequenceFlow id="f6" sourceRef="t5" targetRef="g" />
    <sequenceFlow id="f7" name="yes" sourceRef="g" targetRef="t2" />
    <sequenceFlow id="f8" name="no" sourceRef="g" targetRef="e" />
  </process>
