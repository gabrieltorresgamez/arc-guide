<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.org/bpmn">
  <process id="orderProcess" isExecutable="true">
    <startEvent id="start" name="Order received">
      <outgoing>f1</outgoing>
    </startEvent>
    <serviceTask id="reserve" name="Reserve item">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
      <multiInstanceLoopCharacteristics />
    </serviceTask>
    <scriptTask id="total" name="Total prices">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
    </scriptTask>
    <manualTask id="pack" name="Pack parcel">
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
    </manualTask>
    <endEvent id="end" name="Order packed">
      <incoming>f4</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="start" targetRef="reserve" />
    <sequenceFlow id="f2" sourceRef="reserve" targetRef="total" />
    <sequenceFlow id="f3" sourceRef="total" targetRef="pack" />
    <sequenceFlow id="f4" sourceRef="pack" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_orderProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_orderProcess" bpmnElement="orderProcess">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="68" y="143" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_reserve" bpmnElement="reserve">
        <dc:Bounds x="216" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_total" bpmnElement="total">
        <dc:Bounds x="416" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_pack" bpmnElement="pack">
        <dc:Bounds x="616" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <dc:Bounds x="816" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="791" y="143" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f1" bpmnElement="f1">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="216" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f2" bpmnElement="f2">
        <di:waypoint x="316" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f3" bpmnElement="f3">
        <di:waypoint x="516" y="120" />
        <di:waypoint x="616" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f4" bpmnElement="f4">
        <di:waypoint x="716" y="120" />
        <di:waypoint x="816" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
