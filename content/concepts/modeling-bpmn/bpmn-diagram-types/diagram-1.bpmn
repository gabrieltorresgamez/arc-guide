<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.com/bpmn">
  <collaboration id="collab">
    <participant id="pCustomer" name="Customer" />
    <participant id="pShop" name="Shop" processRef="shopProcess" />
    <messageFlow id="mf1" name="Order" sourceRef="pCustomer" targetRef="start" />
  </collaboration>
  <process id="shopProcess" isExecutable="false">
    <startEvent id="start" name="Order received">
      <outgoing>s1</outgoing>
    </startEvent>
    <task id="check" name="Check order">
      <incoming>s1</incoming>
      <outgoing>s2</outgoing>
    </task>
    <endEvent id="end" name="Order accepted">
      <incoming>s2</incoming>
    </endEvent>
    <sequenceFlow id="s1" sourceRef="start" targetRef="check" />
    <sequenceFlow id="s2" sourceRef="check" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_collab">
    <bpmndi:BPMNPlane id="BPMNPlane_collab" bpmnElement="collab">
      <bpmndi:BPMNShape id="BPMNShape_pCustomer" bpmnElement="pCustomer" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="300" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_pShop" bpmnElement="pShop" isHorizontal="true">
        <dc:Bounds x="142" y="220" width="482" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_mf1" bpmnElement="mf1">
        <di:waypoint x="230" y="140" />
        <di:waypoint x="230" y="282" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="235" y="204" width="41" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <dc:Bounds x="212" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="200" y="323" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_check" bpmnElement="check">
        <dc:Bounds x="348" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <dc:Bounds x="548" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="536" y="323" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_s1" bpmnElement="s1">
        <di:waypoint x="248" y="300" />
        <di:waypoint x="348" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_s2" bpmnElement="s2">
        <di:waypoint x="448" y="300" />
        <di:waypoint x="548" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
