<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.org/wp">
  <process id="refund" isExecutable="false">
    <startEvent id="s" name="Request received">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="register" name="Register request">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <parallelGateway id="split" name="Split">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <outgoing>f4</outgoing>
    </parallelGateway>
    <task id="pay" name="Prepare payment">
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
    </task>
    <task id="notify" name="Notify customer">
      <incoming>f4</incoming>
      <outgoing>f6</outgoing>
    </task>
    <parallelGateway id="join" name="Join">
      <incoming>f5</incoming>
      <incoming>f6</incoming>
      <outgoing>f7</outgoing>
    </parallelGateway>
    <task id="close" name="Close case">
      <incoming>f7</incoming>
      <outgoing>f8</outgoing>
    </task>
    <endEvent id="e" name="Done">
      <incoming>f8</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="s" targetRef="register" />
    <sequenceFlow id="f2" sourceRef="register" targetRef="split" />
    <sequenceFlow id="f3" sourceRef="split" targetRef="pay" />
    <sequenceFlow id="f4" sourceRef="split" targetRef="notify" />
    <sequenceFlow id="f5" sourceRef="pay" targetRef="join" />
    <sequenceFlow id="f6" sourceRef="notify" targetRef="join" />
    <sequenceFlow id="f7" sourceRef="join" targetRef="close" />
    <sequenceFlow id="f8" sourceRef="close" targetRef="e" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_refund">
    <bpmndi:BPMNPlane id="BPMNPlane_refund" bpmnElement="refund">
      <bpmndi:BPMNShape id="BPMNShape_s" bpmnElement="s">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
