<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.com/bpmn">
  <dataStore id="ds1" name="Customer database" />
  <process id="p1" isExecutable="false">
    <dataObject id="do1" name="Order" />
    <dataObjectReference id="ref1" name="Order" dataObjectRef="do1" />
    <dataStoreReference id="dsr1" name="Customer database" dataStoreRef="ds1" />
    <startEvent id="s">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="t1" name="Check order">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
      <dataInputAssociation id="a0">
        <sourceRef>dsr1</sourceRef>
      </dataInputAssociation>
      <dataOutputAssociation id="a1">
        <targetRef>ref1</targetRef>
      </dataOutputAssociation>
    </task>
    <task id="t2" name="Ship order">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <dataInputAssociation id="a2">
        <sourceRef>ref1</sourceRef>
      </dataInputAssociation>
    </task>
    <endEvent id="e">
      <incoming>f3</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="s" targetRef="t1" />
    <sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <sequenceFlow id="f3" sourceRef="t2" targetRef="e" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="p1">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="150" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="240" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="390" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="540" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ref1_di" bpmnElement="ref1">
        <dc:Bounds x="333" y="60" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dsr1_di" bpmnElement="dsr1">
        <dc:Bounds x="255" y="340" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="186" y="240" />
        <di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="340" y="240" />
        <di:waypoint x="390" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="490" y="240" />
        <di:waypoint x="540" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a0_di" bpmnElement="a0">
        <di:waypoint x="280" y="340" />
        <di:waypoint x="280" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1">
        <di:waypoint x="300" y="200" />
        <di:waypoint x="345" y="132" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a2_di" bpmnElement="a2">
        <di:waypoint x="357" y="132" />
        <di:waypoint x="430" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
