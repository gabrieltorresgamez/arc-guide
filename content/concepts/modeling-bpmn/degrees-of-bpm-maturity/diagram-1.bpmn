        <bpmndi:BPMNLabel>
          <dc:Bounds x="604" y="98" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f4" bpmnElement="f4">
        <di:waypoint x="816" y="120" />
