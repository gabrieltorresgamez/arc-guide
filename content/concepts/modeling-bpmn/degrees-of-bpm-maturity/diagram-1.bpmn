<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.com/bpmn">
  <process id="p1" isExecutable="false">
    <startEvent id="s" name="Request received">
      <outgoing>f1</outgoing>
    </startEvent>
    <serviceTask id="t1" name="AI agent assesses request">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </serviceTask>
    <exclusiveGateway id="g1" name="Confident?" default="f_yes">
      <incoming>f2</incoming>
      <outgoing>f_yes</outgoing>
      <outgoing>f_no</outgoing>
    </exclusiveGateway>
    <userTask id="t2" name="Human reviews result">
      <incoming>f_no</incoming>
      <outgoing>f3</outgoing>
    </userTask>
    <exclusiveGateway id="g2">
      <incoming>f_yes</incoming>
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
    </exclusiveGateway>
    <serviceTask id="t3" name="Complete request">
      <incoming>f4</incoming>
      <outgoing>f5</outgoing>
    </serviceTask>
    <endEvent id="e" name="Done">
      <incoming>f5</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="s" targetRef="t1" />
    <sequenceFlow id="f2" sourceRef="t1" targetRef="g1" />
    <sequenceFlow id="f_yes" name="yes" sourceRef="g1" targetRef="g2" />
    <sequenceFlow id="f_no" name="no" sourceRef="g1" targetRef="t2" />
    <sequenceFlow id="f3" sourceRef="t2" targetRef="g2" />
    <sequenceFlow id="f4" sourceRef="g2" targetRef="t3" />
    <sequenceFlow id="f5" sourceRef="t3" targetRef="e" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p1">
    <bpmndi:BPMNPlane id="BPMNPlane_p1" bpmnElement="p1">
