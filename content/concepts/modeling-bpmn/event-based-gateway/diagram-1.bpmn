<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.com/bpmn">
  <message id="msgDelivered" name="Pizza delivered" />
  <process id="orderPizza" isExecutable="false">
    <startEvent id="start" name="Hungry">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="order" name="Order pizza">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <eventBasedGateway id="gw">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <outgoing>f4</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="delivered" name="Pizza delivered">
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
      <messageEventDefinition messageRef="msgDelivered" />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="timeout" name="60 minutes">
      <incoming>f4</incoming>
      <outgoing>f6</outgoing>
      <timerEventDefinition>
        <timeDuration>PT60M</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <task id="eat" name="Eat pizza">
      <incoming>f5</incoming>
      <outgoing>f7</outgoing>
    </task>
    <task id="call" name="Call restaurant">
      <incoming>f6</incoming>
      <outgoing>f8</outgoing>
    </task>
    <endEvent id="end">
      <incoming>f7</incoming>
      <incoming>f8</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="start" targetRef="order" />
    <sequenceFlow id="f2" sourceRef="order" targetRef="gw" />
    <sequenceFlow id="f3" sourceRef="gw" targetRef="delivered" />
    <sequenceFlow id="f4" sourceRef="gw" targetRef="timeout" />
    <sequenceFlow id="f5" sourceRef="delivered" targetRef="eat" />
    <sequenceFlow id="f6" sourceRef="timeout" targetRef="call" />
    <sequenceFlow id="f7" sourceRef="eat" targetRef="end" />
    <sequenceFlow id="f8" sourceRef="call" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_orderPizza">
    <bpmndi:BPMNPlane id="BPMNPlane_orderPizza" bpmnElement="orderPizza">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="74" y="143" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_order" bpmnElement="order">
        <dc:Bounds x="216" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw" bpmnElement="gw" isMarkerVisible="true">
        <dc:Bounds x="416" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_delivered" bpmnElement="delivered">
        <dc:Bounds x="566" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="551" y="143" width="67" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_timeout" bpmnElement="timeout">
        <dc:Bounds x="566" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="547" y="303" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_eat" bpmnElement="eat">
        <dc:Bounds x="702" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_call" bpmnElement="call">
        <dc:Bounds x="702" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <dc:Bounds x="902" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f1" bpmnElement="f1">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="216" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f2" bpmnElement="f2">
        <di:waypoint x="316" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f3" bpmnElement="f3">
        <di:waypoint x="466" y="120" />
        <di:waypoint x="566" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f5" bpmnElement="f5">
        <di:waypoint x="602" y="120" />
        <di:waypoint x="702" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f7" bpmnElement="f7">
        <di:waypoint x="802" y="120" />
        <di:waypoint x="902" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f4" bpmnElement="f4">
        <di:waypoint x="441" y="145" />
        <di:waypoint x="441" y="280" />
        <di:waypoint x="566" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f6" bpmnElement="f6">
        <di:waypoint x="602" y="280" />
        <di:waypoint x="702" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f8" bpmnElement="f8">
        <di:waypoint x="802" y="280" />
        <di:waypoint x="920" y="280" />
        <di:waypoint x="920" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
