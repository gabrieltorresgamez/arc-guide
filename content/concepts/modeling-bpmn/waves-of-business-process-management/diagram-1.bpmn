<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.org/bpm">
  <process id="p1" isExecutable="false">
    <startEvent id="s" name="Step under review">
      <outgoing>f1</outgoing>
    </startEvent>
    <exclusiveGateway id="g1" name="Adds value?">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
      <outgoing>f3</outgoing>
    </exclusiveGateway>
    <task id="t1" name="Remove the step">
      <incoming>f2</incoming>
      <outgoing>f4</outgoing>
    </task>
    <task id="t2" name="Keep and consider automating">
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
    </task>
    <exclusiveGateway id="g2">
      <incoming>f4</incoming>
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
    </exclusiveGateway>
    <endEvent id="e" name="Decision made">
      <incoming>f6</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="s" targetRef="g1" />
    <sequenceFlow id="f2" name="no" sourceRef="g1" targetRef="t1" />
    <sequenceFlow id="f3" name="yes" sourceRef="g1" targetRef="t2" />
    <sequenceFlow id="f4" sourceRef="t1" targetRef="g2" />
    <sequenceFlow id="f5" sourceRef="t2" targetRef="g2" />
    <sequenceFlow id="f6" sourceRef="g2" targetRef="e" />
  </process>
