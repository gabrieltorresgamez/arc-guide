<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.com/bpmn">
  <process id="order" isExecutable="false">
    <startEvent id="s" name="Order received">
      <outgoing>f1</outgoing>
    </startEvent>
    <exclusiveGateway id="split" name="Express?">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
      <outgoing>f3</outgoing>
    </exclusiveGateway>
    <task id="std" name="Standard shipping">
      <incoming>f2</incoming>
      <outgoing>f4</outgoing>
    </task>
    <task id="exp" name="Express shipping">
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
    </task>
    <exclusiveGateway id="merge">
      <incoming>f4</incoming>
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
    </exclusiveGateway>
    <task id="inv" name="Send invoice">
      <incoming>f6</incoming>
      <outgoing>f7</outgoing>
    </task>
    <endEvent id="e" name="Order done">
      <incoming>f7</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="s" targetRef="split" />
    <sequenceFlow id="f2" name="no" sourceRef="split" targetRef="std" />
    <sequenceFlow id="f3" name="yes" sourceRef="split" targetRef="exp" />
    <sequenceFlow id="f4" sourceRef="std" targetRef="merge" />
    <sequenceFlow id="f5" sourceRef="exp" targetRef="merge" />
    <sequenceFlow id="f6" sourceRef="merge" targetRef="inv" />
    <sequenceFlow id="f7" sourceRef="inv" targetRef="e" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_order">
    <bpmndi:BPMNPlane id="BPMNPlane_order" bpmnElement="order">
      <bpmndi:BPMNShape id="BPMNShape_s" bpmnElement="s">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="68" y="143" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_split" bpmnElement="split" isMarkerVisible="true">
        <dc:Bounds x="216" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="210" y="76" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_std" bpmnElement="std">
