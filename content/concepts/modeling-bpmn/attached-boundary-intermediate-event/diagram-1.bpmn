<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.com/bpmn">
  <process id="p1" isExecutable="false">
    <startEvent id="start" name="Application received">
      <outgoing>f1</outgoing>
    </startEvent>
    <userTask id="review" name="Review application">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </userTask>
    <boundaryEvent id="reminder" name="After 1 day" cancelActivity="false" attachedToRef="review">
      <outgoing>f3</outgoing>
      <timerEventDefinition />
    </boundaryEvent>
    <boundaryEvent id="timeout" name="After 2 days" attachedToRef="review">
      <outgoing>f5</outgoing>
      <timerEventDefinition />
    </boundaryEvent>
    <sendTask id="remind" name="Send reminder">
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
    </sendTask>
    <task id="cancel" name="Cancel review">
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
    </task>
    <endEvent id="endOk" name="Reviewed">
      <incoming>f2</incoming>
    </endEvent>
    <endEvent id="endRem" name="Reminder sent">
      <incoming>f4</incoming>
    </endEvent>
    <endEvent id="endTimeout" name="Timed out">
      <incoming>f6</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="start" targetRef="review" />
    <sequenceFlow id="f2" sourceRef="review" targetRef="endOk" />
    <sequenceFlow id="f3" sourceRef="reminder" targetRef="remind" />
    <sequenceFlow id="f4" sourceRef="remind" targetRef="endRem" />
    <sequenceFlow id="f5" sourceRef="timeout" targetRef="cancel" />
    <sequenceFlow id="f6" sourceRef="cancel" targetRef="endTimeout" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p1">
